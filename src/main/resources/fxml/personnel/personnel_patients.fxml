<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Maquette sans données fictives. Style CSS appliqué par SceneManager. -->
<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sio.neurolink.controller.personnel.PatientsController"
            prefWidth="1300" prefHeight="800">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
      <Label text="NEUROLINK CLINIC" styleClass="brand"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label text="Espace personnel administratif" styleClass="user-label"/>
      <Button text="Déconnexion" styleClass="secondary" onAction="#deconnexion"/>
    </HBox>
  </top>
  <left>
    <VBox prefWidth="230" styleClass="sidebar" spacing="7">
<Button text="Tableau de bord" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirDashboard"/>
<Button text="Patients" styleClass="nav-button, nav-active" maxWidth="Infinity" onAction="#ouvrirPatients"/>
<Button text="Médecins" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirMedecins"/>
<Button text="Salles" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirSalles"/>
<Button text="Demandes" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirDemandes"/>
<Button text="Planning" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirPlanning"/>
    </VBox>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
      <content>
        <VBox spacing="18" styleClass="content" fillWidth="true">
          <Label text="PATIENTS" styleClass="title" />
          <Label text="Consulter les dossiers patients et mettre à jour uniquement les coordonnées autorisées." styleClass="stat-label" wrapText="true"/>
          <HBox spacing="10" alignment="CENTER_LEFT"><TextField fx:id="recherchePatient" promptText="Rechercher par nom" maxWidth="Infinity" styleClass="home-text-field"/><Button text="Rechercher" styleClass="secondary" disable="true"/><Button text="Créer un patient" styleClass="btn-primary" onAction="#ouvrirCreationPatient"/></HBox><VBox spacing="12" styleClass="card" maxWidth="Infinity"><Label text="Liste des patients" styleClass="section-label" /><TableView fx:id="tablePatients" prefHeight="365" maxWidth="Infinity"><columns><TableColumn text="N° dossier" prefWidth="130"/><TableColumn text="Nom" prefWidth="160"/><TableColumn text="Prénom" prefWidth="160"/><TableColumn text="Date de naissance" prefWidth="170"/><TableColumn text="Téléphone" prefWidth="170"/><TableColumn text="Statut" prefWidth="130"/></columns><placeholder><Label text="Aucune donnée à afficher pour le moment."/></placeholder></TableView><HBox spacing="10"><Button text="Ouvrir la fiche (maquette)" styleClass="secondary" onAction="#ouvrirFichePatient"/><Button text="Désactiver / Réactiver" styleClass="secondary" disable="true"/></HBox></VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>

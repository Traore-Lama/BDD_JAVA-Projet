<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Maquette sans données fictives. Style CSS appliqué par SceneManager. -->
<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sio.neurolink.controller.personnel.PersonnelDashboardController"
            prefWidth="1300" prefHeight="800">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
      <Label text="NEUROLINK CLINIC" styleClass="brand"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label text="Espace personnel administratif" styleClass="user-label"/>
      <Button text="Déconnexion" styleClass="secondary" onAction="#deconnexion"/>
    </HBox>
  </top>
  <left>
    <VBox prefWidth="230" styleClass="sidebar" spacing="7">
<Button text="Tableau de bord" styleClass="nav-button, nav-active" maxWidth="Infinity" onAction="#ouvrirDashboard"/>
<Button text="Patients" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirPatients"/>
<Button text="Médecins" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirMedecins"/>
<Button text="Salles" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirSalles"/>
<Button text="Demandes" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirDemandes"/>
<Button text="Planning" styleClass="nav-button" maxWidth="Infinity" onAction="#ouvrirPlanning"/>
    </VBox>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
      <content>
        <VBox spacing="18" styleClass="content" fillWidth="true">
          <Label text="TABLEAU DE BORD" styleClass="title" />
          <Label text="Vue des demandes à traiter, des salles disponibles et des interventions du jour." styleClass="stat-label" wrapText="true"/>
          <HBox spacing="14"><VBox spacing="7" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity"><Label text="Demandes en attente" styleClass="metric-label" wrapText="true"/><Label text="—" styleClass="metric" fx:id="lblDemandes"/></VBox><VBox spacing="7" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity"><Label text="Interventions du jour" styleClass="metric-label" wrapText="true"/><Label text="—" styleClass="metric" fx:id="lblInterventionsJour"/></VBox><VBox spacing="7" styleClass="card" HBox.hgrow="ALWAYS" maxWidth="Infinity"><Label text="Salles disponibles" styleClass="metric-label" wrapText="true"/><Label text="—" styleClass="metric" fx:id="lblSalles"/></VBox></HBox><VBox spacing="12" styleClass="card" maxWidth="Infinity"><Label text="Interventions du jour" styleClass="section-label" /><TableView fx:id="tableInterventionsJour" prefHeight="390" maxWidth="Infinity"><columns><TableColumn text="Heure" prefWidth="130"/><TableColumn text="Patient" prefWidth="240"/><TableColumn text="Médecin" prefWidth="240"/><TableColumn text="Salle" prefWidth="210"/></columns><placeholder><Label text="Aucune donnée à afficher pour le moment."/></placeholder></TableView></VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>

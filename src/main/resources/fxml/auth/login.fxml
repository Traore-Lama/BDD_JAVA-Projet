<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sio.neurolink.controller.auth.LoginController"
      prefWidth="1300"
      prefHeight="800"
      styleClass="home-root">

    <children>

        <!-- PARTIE GAUCHE : FORMULAIRE -->
        <VBox prefWidth="650"
              alignment="CENTER"
              styleClass="home-form-side">

            <children>

                <VBox alignment="CENTER_LEFT"
                      spacing="12"
                      maxWidth="444"
                      prefWidth="444">

                    <children>

                        <!-- TITRE -->
                        <Text text="NeuroLink Clinic"
                              styleClass="home-brand-title"/>

                        <Text text="Espace de connexion du personnel"
                              styleClass="home-brand-subtitle"/>

                        <Region prefHeight="28"/>

                        <!-- ADRESSE E-MAIL -->
                        <VBox spacing="7"
                              alignment="CENTER_LEFT">

                            <children>

                                <Text text="ADRESSE E-MAIL"
                                      styleClass="home-field-label"/>

                                <!-- MODIFICATION ICI : fx:id="txtLogin" -->
                                <TextField fx:id="txtLogin"
                                           promptText="Entrez votre adresse e-mail"
                                           prefWidth="444"
                                           styleClass="home-text-field"/>

                            </children>
                        </VBox>

                        <Region prefHeight="5"/>

                        <!-- MOT DE PASSE -->
                        <VBox spacing="7"
                              alignment="CENTER_LEFT">

                            <children>

                                <Text text="MOT DE PASSE"
                                      styleClass="home-field-label"/>

                                <!-- MODIFICATION ICI : fx:id="txtMotDePasse" -->
                                <PasswordField fx:id="txtMotDePasse"
                                               promptText="Entrez votre mot de passe"
                                               prefWidth="444"
                                               styleClass="home-text-field"/>

                            </children>
                        </VBox>

                        <Region prefHeight="20"/>

                        <!-- BOUTON -->
                        <!-- MODIFICATION ICI : fx:id="btnConnexion" et onAction="#btnConnexionClicked" -->
                        <Button fx:id="btnConnexion"
                                text="Se connecter"
                                onAction="#btnConnexionClicked"
                                prefWidth="444"
                                styleClass="btn-primary"/>

                        <!-- MODIFICATION ICI : AJOUT DU LABEL D'ERREUR (style rouge) -->
                        <Label fx:id="txtErreur"
                               textFill="red"
                               style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;" />

                        <Region prefHeight="18"/>

                        <!-- MESSAGE -->
                        <Text text="Accès réservé au personnel autorisé"
                              styleClass="home-footer-text"/>

                    </children>

                </VBox>

            </children>

        </VBox>

        <!-- PARTIE DROITE : PHOTO -->
        <StackPane prefWidth="650"
                   prefHeight="800">

            <children>

                <ImageView fitWidth="650"
                           fitHeight="800"
                           preserveRatio="false">

                    <image>
                        <Image url="@/images/clinique.jpeg"/>
                    </image>

                </ImageView>

                <!-- DEGRADE ET TEXTE SUR LA PHOTO -->
                <VBox alignment="BOTTOM_LEFT"
                      spacing="8"
                      prefHeight="160"
                      minHeight="160"
                      maxHeight="160"
                      style="-fx-padding: 28;"
                      styleClass="home-photo-overlay"
                      StackPane.alignment="BOTTOM_LEFT">

                    <children>

                        <Text text="Bienvenue chez NeuroLink Clinic"
                              styleClass="home-photo-caption-title"/>

                        <Text text="Une clinique connectée, une gestion simplifiée."
                              styleClass="home-photo-caption-sub"/>

                    </children>

                </VBox>

            </children>

        </StackPane>

    </children>

</HBox>